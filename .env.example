# =============================================================================
# Central de Chamados FADEX — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` e ajuste os valores.
#     cp .env.example .env
#
# O arquivo `.env` está no .gitignore e NUNCA deve ser versionado.
# Este arquivo (.env.example) contém apenas as chaves esperadas, sem segredos reais.
# =============================================================================

# --- Banco de dados (MySQL 8) -------------------------------------------------
MYSQL_DATABASE=central_chamados
MYSQL_USER=fadex
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PORT=3306

# URL usada pelo backend. Ao rodar via docker compose o host é `mysql`;
# rodando o backend fora do Docker, use `localhost`.
DB_URL=jdbc:mysql://localhost:3306/central_chamados?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Fortaleza&characterEncoding=UTF-8
DB_USERNAME=fadex
DB_PASSWORD=troque-esta-senha

# --- JWT ----------------------------------------------------------------------
# Segredo para assinatura HS256. Gere um valor aleatório com pelo menos 32 bytes:
#     openssl rand -base64 48
JWT_SECRET=gere-um-segredo-aleatorio-de-no-minimo-32-bytes
# Validade do token em milissegundos (padrão: 8 horas)
JWT_EXPIRATION_MS=28800000

# --- Triagem por IA -----------------------------------------------------------
# Provider de classificação automática: `heuristic` (padrão, sem dependência
# externa) ou `gemini` (requer GEMINI_API_KEY; cai automaticamente na
# heurística em caso de erro ou timeout).
TRIAGE_PROVIDER=heuristic

# Chave da Google Gemini API — deixe vazio para usar apenas a heurística.
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Aplicação ----------------------------------------------------------------
SERVER_PORT=8080
FRONTEND_PORT=5173
# Origens permitidas no CORS, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
# URL base da API usada pelo frontend em build de produção
VITE_API_BASE_URL=http://localhost:8080
