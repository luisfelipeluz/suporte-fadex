# =============================================================================
# Central de Chamados FADEX — variáveis de ambiente
# =============================================================================
# O projeto sobe SEM este arquivo: todas as variáveis abaixo já têm o mesmo
# padrão embutido no docker-compose.yml. Copie apenas se for personalizar algo.
#     cp .env.example .env
#
# Os valores aqui são exatamente os padrões de desenvolvimento local, então
# copiar o arquivo sem editar não muda o comportamento da stack. Em qualquer
# ambiente exposto, troque as senhas e o JWT_SECRET.
#
# O `.env` está no .gitignore e NUNCA deve ser versionado.
# =============================================================================

# --- Banco de dados (MySQL 8) -------------------------------------------------
# ATENÇÃO: usuário e senha só são aplicados quando o volume `mysql-data` é criado,
# na primeira subida. Se você já rodou o projeto e mudar estes valores agora, o
# backend não consegue mais autenticar — recrie o volume antes:
#     docker compose down -v
MYSQL_DATABASE=central_chamados
MYSQL_USER=fadex
MYSQL_PASSWORD=fadex
MYSQL_ROOT_PASSWORD=root

# --- JWT ----------------------------------------------------------------------
# Segredo para assinatura HS256. Gere um valor aleatório com pelo menos 32 bytes:
#     openssl rand -base64 48
JWT_SECRET=desenvolvimento-local-troque-este-segredo-com-no-minimo-32-bytes
# Validade do token em milissegundos (padrão: 8 horas)
JWT_EXPIRATION_MS=28800000

# --- Triagem por IA -----------------------------------------------------------
# Provider de classificação automática: `heuristic` (padrão, sem dependência
# externa) ou `gemini` (requer GEMINI_API_KEY; cai automaticamente na
# heurística em caso de erro ou timeout).
TRIAGE_PROVIDER=heuristic

# Chave da Google Gemini API — deixe vazio para usar apenas a heurística.
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos são aposentados com o tempo, e um nome inválido devolve 404 — a triagem
# cai na heurística sem quebrar, mas deixa de usar a IA. Para ver o que a sua
# chave aceita hoje:
#   curl -s https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: SUA_CHAVE"
GEMINI_MODEL=gemini-3.6-flash

# --- Portas publicadas no host ------------------------------------------------
# A 80 é a ÚNICA porta que a stack publica. Se ela já estiver ocupada na sua
# máquina (IIS, Apache, Skype), troque aqui e a aplicação passa a responder em
# http://localhost:8081 — nada mais precisa mudar.
FRONTEND_PORT_PUBLICO=80

# MySQL e backend não publicam porta por padrão, de propósito (veja os
# comentários no docker-compose.yml).
#
# MYSQL_PORT vale quando você sobe o banco com o arquivo de execução local:
#     docker compose -f docker-compose.yml -f docker-compose.local.yml up -d mysql
# SERVER_PORT só tem efeito depois de descomentar o bloco `ports` do backend.
MYSQL_PORT=3307
SERVER_PORT=8080

# Origens permitidas no CORS, separadas por vírgula. Dentro do Docker o nginx
# serve API e interface na mesma origem, então isso só importa para o Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# =============================================================================
# Daqui para baixo: apenas para rodar backend e frontend FORA do Docker (Opção 2
# do README). O docker compose ignora estas variáveis — dentro da stack o
# backend recebe a URL do banco pela rede interna do compose.
#
# ATENÇÃO: fora do Docker, NADA lê este arquivo. `.env` é convenção do compose,
# não do Spring nem do Vite: `mvn spring-boot:run` usa os padrões do
# application.yml (iguais aos valores abaixo) e ignora o que estiver aqui. Para
# de fato mudar algo nesse cenário, exporte no ambiente do processo:
#     $env:DB_PASSWORD='...'; mvn spring-boot:run        # PowerShell
#     DB_PASSWORD=... mvn spring-boot:run                # bash
# =============================================================================

# Banco publicado no host em 3307 por docker-compose.local.yml
DB_URL=jdbc:mysql://localhost:3307/central_chamados?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Fortaleza&characterEncoding=UTF-8
DB_USERNAME=fadex
DB_PASSWORD=fadex

# Porta do servidor de desenvolvimento do Vite
FRONTEND_PORT=5173
# Base da API no build do frontend. Vazio = caminhos relativos (`/api/...`), que
# funciona nos dois cenários: o nginx faz o proxy no Docker e o servidor de
# desenvolvimento do Vite faz o proxy fora dele.
VITE_API_BASE_URL=